dep_vars_of_interest <- dependent_vars %>% purrr::discard(stringr::str_detect, pattern = "speciesNo") %>% purrr::discard(stringr::str_detect, pattern = "upperHalf") %>% select_v(-c("all_species_territories", "cti_territories_weighted"))
univar_models <- list()
for (dep_var in dep_vars_of_interest){
# "halbe reviere variable"
test_data <- bird_data
test_data$halbe <- bird_data[[dep_var]]*2
# null model
null_model <- fit_null_model(
data = test_data,
response_var = "halbe",
family = "poisson"
)
# univariable model table
univar_models[[dep_var]] <- bl_make_univar_models_summary(
test_data,
dependent_var = "halbe",
independent_var =  independent_vars_numeric,
random_formula = "(1|sub_area)",
model_family = "poisson",
null_model = null_model,
debugging = T
)
}
cti_null <- fit_null_model(
data = bird_data,
response_var = "cti_territories_weighted",
family = "gaussian"
)
univar_models$cti_territories <- bl_make_univar_models_summary(
bird_data,
dependent_var = "cti_territories_weighted",
independent_var =  independent_vars_numeric,
random_formula = "(1|sub_area)",
model_family = "gaussian",
null_model = cti_null,
debugging = T
)
