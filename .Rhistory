nm  <- names(univar_models)
nm
colidx <- lapply(seq_along(univar_models), function(i) {
if (i == 1)                          1:4   # erstes DF: Spalten 1–4 (wie vorher)
else if (grepl("_upperHalf$", nm[i])) 4:5  # upperHalf-DFs: Spalten 4–5
else                                 3:4   # alle übrigen: Spalten 3–4
})
colidx
tabs <- Map(function(x, i) x[i], univar_models, colidx)
tab  <- do.call(cbind, tabs)
tab
nm2  <- names(univar_models)
colidx2 <- lapply(seq_along(univar_models), function(i) {
if (i == 1)                          1:4   # erstes DF: Spalten 1–4 (wie vorher)
else if (grepl("_upperHalf$", nm[i])) 4:5  # upperHalf-DFs: Spalten 4–5
else                                 3:4   # alle übrigen: Spalten 3–4
})
tabs2 <- Map(function(x, i) x[i], univar_models, colidx2)
tab2  <- do.call(cbind, tabs2)
tab2
#bl_save_xlsx(tab, paste0(results_folder, "all_univar_models_summary_.xlsx"))
bl_save_xlsx(tab2, paste0(results_folder, "territory_univar_models_summary_.xlsx"))
